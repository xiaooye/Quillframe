; NovelForge Product Runtime
; Godot is the product presentation layer. Docs remain Astro/Starlight.
config_version=5

[application]

config/name="NovelForge"
config/description="NovelForge agentic fiction production control room"
run/main_scene="res://Main.tscn"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.035, 0.055, 1)

[gui]

theme/default_font_multichannel_signed_distance_field=true
