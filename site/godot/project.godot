; NovelForge Product Runtime
; Godot is the product presentation layer. Docs remain Astro/Starlight.
config_version=5

[application]

config/name="NovelForge"
config/description="NovelForge agentic fiction production control room"
run/main_scene="res://Main.tscn"

[display]

; The product UI is a non-game application. The base size is deliberately the
; smallest supported surface; Web export uses an adaptive canvas and disabled
; content stretching so one scene unit tracks one browser pixel.
window/size/viewport_width=390
window/size/viewport_height=700
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.035, 0.055, 1)

[gui]

theme/default_font_multichannel_signed_distance_field=true
