{
  "name": "quillframe",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "quillframe.wei-dev.com/*",
      "zone_name": "wei-dev.com"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    // Product routes are handled by dist/_redirects. Do not enable a global
    // SPA fallback here because /docs is an independent Astro/Starlight tree.
    "directory": "./dist"
  }
}
