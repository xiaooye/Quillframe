{
  "name": "@novelforge/product-site",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "foundation": "node scripts/sync-weiui.mjs",
    "content": "npm run foundation && node scripts/build-content.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "quality": "npm run content && node scripts/quality.mjs"
  },
  "dependencies": {
    "@solidjs/router": "0.16.2",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "marked": "18.0.7",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-solid": "2.11.14"
  }
}
