---
import Default from "@astrojs/starlight/components/PageTitle.astro";

const route = Astro.locals.starlightRoute;
const { title, description } = route.entry.data;
const english = route.lang.toLowerCase().startsWith("en");
const pathname = Astro.url.pathname.replace(/\/+$/, "");
const isDocsHome = pathname === "/docs" || pathname === "/docs/en";
const slug = pathname.split("/").filter(Boolean).at(-1) ?? "";
const eyebrow = english ? "Quillframe Docs" : "Quillframe 知识库";

const sections = [
  {
    ids: new Set(["why-quillframe", "architecture", "studio-overview"]),
    zh: "开始",
    en: "Start",
  },
  {
    ids: new Set(["production-pipeline", "context-memory", "story-system", "character-system", "canon-state"]),
    zh: "写作",
    en: "Write",
  },
  {
    ids: new Set(["quality-assurance", "reader-engagement", "quality-evolution", "candidate-lineage", "evals-overview"]),
    zh: "审阅",
    en: "Review",
  },
  {
    ids: new Set(["release-bundle", "product-site-overview"]),
    zh: "发布",
    en: "Publish",
  },
  {
    ids: new Set(["model-runtime", "agent-runtime", "integrations", "project-contract", "studio-product-architecture"]),
    zh: "连接与运维",
    en: "Connect & operate",
  },
];

const section = sections.find((item) => item.ids.has(slug));
const sectionLabel = section ? (english ? section.en : section.zh) : (english ? "Reference" : "完整参考");
---

{
  isDocsHome ? (
    <Default><slot /></Default>
  ) : (
    <header class="nf-article-title" data-doc-section={slug}>
      <div class="nf-article-title__meta">
        <span class="nf-article-title__eyebrow"><span aria-hidden="true">✦</span>{eyebrow}</span>
        <span class="nf-article-title__section">{sectionLabel}</span>
      </div>
      <h1 id="_top">{title}</h1>
      {description && <p class="nf-article-title__lede">{description}</p>}
      <div class="nf-article-title__rule" aria-hidden="true"><span></span><i>◇</i><span></span></div>
    </header>
  )
}
