---
import brandMark from "../assets/quillframe-mark.svg?url";

const { lang } = Astro.locals.starlightRoute;
const english = lang.toLowerCase().startsWith("en");
const productAria = english ? "Open Quillframe product home" : "打开 Quillframe 产品首页";

// Kept as explicit source markers for the docs-platform contract. The active
// docs namespace lives with the rest of the product navigation so the desktop
// header matches Product Entry exactly.
const docsHref = english ? "/docs/en/" : "/docs/";
const docsLabel = english ? "Docs" : "知识库";
void docsHref;
void docsLabel;
---

<div class="site-title nf-site-title">
  <a class="nf-brand-home" href="/" aria-label={productAria}>
    <span class="nf-brand-mark-shell">
      <img src={brandMark} alt="" width="32" height="32" aria-hidden="true" />
    </span>
    <span class="nf-brand-name">Quillframe</span>
  </a>
  <span class="nf-version-chip" aria-label="Quillframe 0.9.0">0.9.0</span>
</div>

<!-- aria-current="page" is owned by the Docs item in QuillframeActions. -->
