---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

interface Props {
  locale: "zh-CN" | "en";
}

const { locale } = Astro.props;
const english = locale === "en";

const copy = english
  ? {
      title: "Quillframe Documentation",
      description: "Task-oriented Quillframe documentation for product fit, project integration, writing systems, model/agent runtime, quality, publication, and Studio.",
      heroTitle: "Keep authority, state, and quality gates explicit as a long-form story grows.",
      heroTagline: "Start with what you need to do. Drop into the exact contracts only when implementation details matter.",
      primaryAction: "Why Quillframe",
      secondaryAction: "Explore the product",
      eyebrow: "Choose a path",
      intro: "You do not need to read the framework from top to bottom. Pick the outcome you need and follow the shortest useful path.",
      paths: [
        ["Inspect an existing project", "Open a Quillframe project folder locally and verify its manifest, exact framework lock, attestation, and structural evidence without uploading the project.", "/inspect", "⌂"],
        ["Decide whether Quillframe fits", "Compare the product model, its tradeoffs, and the cases where a simpler writing agent or another authoring tool is a better fit.", "/docs/en/why-quillframe", "✦"],
        ["Understand the architecture", "See how project authority, model judgment, deterministic runtime behavior, state, and writes are kept separate.", "/docs/en/architecture", "⌘"],
        ["Connect model inference", "Use API Endpoint + Access Token while Quillframe owns discovery, capability evidence, model selection, and the agent loop.", "/docs/en/model-runtime", "◇"],
        ["Draft or revise prose", "Follow a production run from context and causality through drafting, review, repair, and acceptance.", "/docs/en/production-pipeline", "✎"],
        ["Review and gate quality", "Separate deterministic checks from semantic judgment, route findings to the owning subsystem, and gate user-visible output explicitly.", "/docs/en/quality-assurance", "✓"],
      ],
      runtimeTitle: "Run, extend, and inspect",
      runtimeIntro: "Once the product model is clear, these are the practical entry points for execution, inspection, and integration.",
      runtime: [
        ["Product home", "Start from the main product entry, then move into inspection, architecture, publication, or Studio as the task becomes clear.", "/", "✦"],
        ["Project Inspector", "Inspect a real project locally in the browser before deciding what should run next.", "/inspect", "⌂"],
        ["Local Playground", "Try the deterministic DRAFT / REVISE / AUDIT / PLAN-CHAPTER flow without model calls or write authority.", "/playground", "▷"],
        ["Agent workbench", "Explore the live agent-integration surface while keeping provider capability, tool access, and Quillframe authority as separate concerns.", "/agents", "⌁"],
        ["Agent Runtime", "Understand AgentJob, tools, budgets, checkpoints, receipts, and Quillframe's model → tool → model loop.", "/docs/en/agent-runtime", "◈"],
        ["Runtime & integrations", "Understand host capabilities, transport choices, and practical integration paths.", "/docs/en/integrations", "↗"],
        ["Context & memory", "See what enters active Context, what persists, and what must never silently become Canon.", "/docs/en/context-memory", "◌"],
        ["Semantic execution", "Keep typed semantic work consistent across eligible execution transports while preserving fingerprint and independence rules.", "/docs/en/semantic-execution", "⌁"],
        ["Quillframe Studio", "Inspect projects, runs, Context, readiness, and the author-facing workflow surface without inventing Core authority in the UI.", "/docs/en/studio-overview", "✧"],
      ],
      modelTitle: "Three documentation layers",
      modelIntro: "Product concepts, usage guidance, and exact engineering contracts stay separate so each page can serve the reader who actually needs it.",
      tiers: [
        ["A", "Product concepts", "Mental models, positioning, architecture, production flow, and quality. Start here if Quillframe is new to you."],
        ["B", "Usage guides", "Project SDK, Model/Agent Runtime, integrations, Context, learning, Corpus, evaluations, quality evolution, and Studio."],
        ["C", "Contracts & engineering records", "Harness, runtime, semantic workers, story and Canon mechanics, policies, and historical specifications."],
      ],
      tierLabel: (tier: string) => `Tier ${tier}`,
      referenceEyebrow: "Reference",
      referenceTitle: "Need the exact contract?",
      referenceBody: "Use the architecture atlas to find the subsystem that owns the behavior, then open the full reference only when implementation-level precision is necessary.",
      referenceAction: "Open the architecture atlas",
    }
  : {
      title: "Quillframe 文档中心",
      description: "按任务组织的 Quillframe 文档：产品判断、项目接入、创作机制、Model/Agent Runtime、质量保障、出版与 Studio。",
      heroTitle: "长篇故事不断增长，权威、状态和质量门槛仍然清清楚楚。",
      heroTagline: "先从你现在要完成的事情开始；只有真正需要实现细节时，再进入精确契约。",
      primaryAction: "为什么选择 Quillframe",
      secondaryAction: "进入产品首页",
      eyebrow: "按目标开始",
      intro: "不需要从头到尾读完整个框架。先选你此刻要完成的事情，再沿着最短的阅读路径进入需要的深度。",
      paths: [
        ["检查现有 Quillframe 项目", "直接在浏览器本地打开项目文件夹，检查项目清单、精确框架锁定、框架证明和结构证据；项目内容不会上传。", "/inspect", "⌂"],
        ["判断 Quillframe 是否适合", "了解产品定位与实际取舍，并比较通用编程智能体、简单写作助手和作者工具在不同场景下是否更合适。", "/docs/why-quillframe", "✦"],
        ["理解总体架构", "看清项目权威、模型语义判断、确定性运行时、状态与写入边界如何彼此分离。", "/docs/architecture", "⌘"],
        ["连接模型推理", "用户只提供 API Endpoint + Access Token；模型发现、能力证据、模型选择与 agent loop 仍由 Quillframe 负责。", "/docs/model-runtime", "◇"],
        ["写作或修改正文", "从上下文与因果进入起草、审阅、修复与接受，理解一轮完整的正文生产运行。", "/docs/production-pipeline", "✎"],
        ["审核并把住质量门槛", "把确定性检查与语义判断分开，把问题交给真正负责的子系统，并明确决定什么可以交给用户。", "/docs/quality-assurance", "✓"],
      ],
      runtimeTitle: "运行、扩展与检查",
      runtimeIntro: "建立产品心智模型后，可以从这些入口进入实际执行、检查与集成。",
      runtime: [
        ["产品首页", "从主产品入口开始，再根据任务进入项目检查、架构、出版或 Studio。", "/", "✦"],
        ["项目检查器", "先在浏览器本地检查一个真实项目，再决定下一步应该运行什么。", "/inspect", "⌂"],
        ["本地演练场", "不调用模型，也不获得写入权威，直接试运行 DRAFT / REVISE / AUDIT / PLAN-CHAPTER 的确定性流程。", "/playground", "▷"],
        ["智能体接入工作台", "查看真实的 agent integration surface，同时把 provider capability、工具访问与 Quillframe authority 保持为彼此独立的概念。", "/agents", "⌁"],
        ["Agent Runtime", "理解 AgentJob、工具、预算、checkpoint、receipt，以及 Quillframe 自己的 model → tool → model loop。", "/docs/agent-runtime", "◈"],
        ["运行时与集成", "理解宿主能力、传输方式与实际接入路径。", "/docs/integrations", "↗"],
        ["上下文与记忆", "理解什么会进入当前 Context、什么会持久化，以及什么绝不能悄悄变成 Canon。", "/docs/context-memory", "◌"],
        ["语义执行", "让同一类型化语义任务在合格执行渠道之间保持 fingerprint、independence 与结果契约一致。", "/docs/semantic-execution", "⌁"],
        ["Quillframe Studio", "查看项目、运行、Context、就绪状态和面向作者的工作界面，同时不让 UI 自己发明 Core authority。", "/docs/studio-overview", "✧"],
      ],
      modelTitle: "文档分三层",
      modelIntro: "产品概念、使用指南和精确工程契约彼此分层，让每一页只服务真正需要这一级细节的读者。",
      tiers: [
        ["A", "产品概念", "心智模型、产品定位、总体架构、生产流程与质量保障。第一次了解 Quillframe，从这里开始。"],
        ["B", "使用指南", "Project SDK、Model/Agent Runtime、集成、Context、学习、语料、评测、质量演化与 Studio。"],
        ["C", "契约与工程记录", "Harness、Runtime、Semantic Worker、故事与 Canon 机制、政策以及历史规范。"],
      ],
      tierLabel: (tier: string) => `第 ${tier} 层`,
      referenceEyebrow: "参考",
      referenceTitle: "需要精确契约？",
      referenceBody: "先用架构图谱找到真正负责这个行为的子系统；只有需要实现级精度时，再进入完整参考。",
      referenceAction: "打开架构图谱",
    };

const frontmatter = {
  title: copy.title,
  description: copy.description,
  template: "splash" as const,
  editUrl: english
    ? "https://github.com/xiaooye/cn_webnovel_agent/blob/main/docs/README.en.md"
    : "https://github.com/xiaooye/cn_webnovel_agent/blob/main/docs/README.zh-CN.md",
  hero: {
    title: copy.heroTitle,
    tagline: copy.heroTagline,
    actions: [
      { text: copy.primaryAction, link: english ? "/docs/en/why-quillframe" : "/docs/why-quillframe", icon: "right-arrow" as const },
      { text: copy.secondaryAction, link: "/", variant: "minimal" as const },
    ],
  },
};
---

<StarlightPage frontmatter={frontmatter} lang={locale}>
  <main class="nf-docs-home" data-nf-docs-home>
    <section class="nf-home-section nf-home-section--lead" aria-labelledby="nf-home-paths">
      <p class="nf-home-eyebrow">{copy.eyebrow}</p>
      <h2 id="nf-home-paths">{copy.eyebrow}</h2>
      <p class="nf-home-lead">{copy.intro}</p>
      <div class="nf-link-grid">
        {copy.paths.map(([title, description, href, icon]) => (
          <a class="nf-link-card" href={href}>
            <span class="nf-link-icon" aria-hidden="true">{icon}</span>
            <span class="nf-link-copy"><strong>{title}</strong><small>{description}</small></span>
            <span class="nf-link-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="nf-home-section" aria-labelledby="nf-home-runtime">
      <div class="nf-home-section-heading">
        <h2 id="nf-home-runtime">{copy.runtimeTitle}</h2>
        <p>{copy.runtimeIntro}</p>
      </div>
      <div class="nf-link-grid nf-link-grid--compact">
        {copy.runtime.map(([title, description, href, icon]) => (
          <a class="nf-link-card" href={href}>
            <span class="nf-link-icon" aria-hidden="true">{icon}</span>
            <span class="nf-link-copy"><strong>{title}</strong><small>{description}</small></span>
            <span class="nf-link-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="nf-home-section nf-home-model" aria-labelledby="nf-home-model">
      <div class="nf-home-section-heading">
        <h2 id="nf-home-model">{copy.modelTitle}</h2>
        <p>{copy.modelIntro}</p>
      </div>
      <div class="nf-tier-grid">
        {copy.tiers.map(([tier, title, body]) => (
          <article class="nf-tier-card">
            <span class="nf-tier-badge">{copy.tierLabel(tier)}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <aside class="nf-reference-callout">
      <div>
        <p class="nf-home-eyebrow">{copy.referenceEyebrow}</p>
        <h2>{copy.referenceTitle}</h2>
        <p>{copy.referenceBody}</p>
      </div>
      <a href={english ? "/docs/en/architecture-atlas" : "/docs/architecture-atlas"}>{copy.referenceAction}<span aria-hidden="true"> →</span></a>
    </aside>
  </main>
</StarlightPage>
