---
import Default from "@astrojs/starlight/components/SocialIcons.astro";

const english = Astro.url.pathname === "/docs/en" || Astro.url.pathname.startsWith("/docs/en/");
const productLabel = english ? "Product" : "产品";
const productAria = english ? "Open NovelForge product site" : "打开 NovelForge 产品站";
const studioAria = english ? "Open NovelForge Studio" : "打开 NovelForge Studio";
---

<a class="nf-product-link" href="/" aria-label={productAria}>{productLabel}</a>
<a class="nf-studio-link" href="https://studio.novelforge.wei-dev.com" target="_blank" rel="noreferrer" aria-label={studioAria}>Studio <span aria-hidden="true">↗</span></a>
<Default><slot /></Default>