---
const english = Astro.url.pathname === "/docs/en" || Astro.url.pathname.startsWith("/docs/en/");
const docsHref = english ? "/docs/en/" : "/docs/";
const githubHref = "https://github.com/xiaooye/cn_webnovel_agent";
const studioHref = "https://studio.quillframe.wei-dev.com";

const labels = english
  ? {
      product: "Product",
      studio: "Studio",
      architecture: "Architecture",
      publication: "Publication",
      docs: "Docs",
      github: "GitHub",
      openStudio: "Open Studio",
    }
  : {
      product: "产品",
      studio: "Studio",
      architecture: "架构",
      publication: "出版",
      docs: "文档",
      github: "GitHub",
      openStudio: "打开 Studio",
    };

const aria = english
  ? {
      product: "Open Quillframe product overview",
      studio: "Open Quillframe Studio overview",
      architecture: "Open Quillframe architecture explorer",
      publication: "Open Quillframe publication workbench",
      docs: "Open Quillframe documentation home",
      github: "Open the Quillframe GitHub repository in a new tab",
      openStudio: "Open Quillframe Studio in a new tab",
    }
  : {
      product: "打开 Quillframe 产品概览",
      studio: "打开 Quillframe Studio 概览",
      architecture: "打开 Quillframe 架构探索",
      publication: "打开 Quillframe 出版工作台",
      docs: "打开 Quillframe 文档首页",
      github: "在新标签页打开 Quillframe GitHub 仓库",
      openStudio: "在新标签页打开 Quillframe Studio",
    };
---

<nav class="nf-product-nav" aria-label={english ? "Quillframe product navigation" : "Quillframe 产品导航"}>
  <a class="nf-product-link" href="/product" aria-label={aria.product}>{labels.product}</a>
  <a class="nf-product-link" href="/studio" aria-label={aria.studio}>{labels.studio}</a>
  <a class="nf-product-link" href="/architecture" aria-label={aria.architecture}>{labels.architecture}</a>
  <a class="nf-product-link" href="/publication" aria-label={aria.publication}>{labels.publication}</a>
  <a class="nf-product-link nf-docs-nav-link" href={docsHref} aria-label={aria.docs} aria-current="page">{labels.docs}</a>
  <a class="nf-product-link nf-github-link" href={githubHref} target="_blank" rel="noopener noreferrer" aria-label={aria.github}>{labels.github}<span aria-hidden="true">↗</span></a>
</nav>
<a class="nf-studio-link" href={studioHref} target="_blank" rel="noopener noreferrer" aria-label={aria.openStudio}><span aria-hidden="true">✦</span>{labels.openStudio}</a>
