{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novelforge_author_steering_contract_v1",
  "title": "NovelForge Author Steering Contract",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/safePoint"},
    {"$ref": "#/$defs/decision"},
    {"$ref": "#/$defs/consumption"}
  ],
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fingerprintArray": {"type": "array", "items": {"$ref": "#/$defs/fingerprint"}, "uniqueItems": true},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "steering_id", "scope", "instruction", "target", "authored_against", "authority"],
      "properties": {
        "schema": {"const": "novelforge_author_steering_request_v1"},
        "steering_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "scope": {"enum": ["current_run", "future_only"]},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 20000},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource_id", "session_id", "run_id", "authored_checkpoint_id", "timing", "future_ref"],
          "properties": {
            "resource_id": {"type": "string", "minLength": 1},
            "session_id": {"type": "string", "minLength": 1},
            "run_id": {"type": "string", "minLength": 1},
            "authored_checkpoint_id": {"type": "string", "minLength": 1},
            "timing": {"enum": ["next_safe_point", "before_draft", "before_review", "future_only"]},
            "future_ref": {"type": ["string", "null"]}
          }
        },
        "authored_against": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_fingerprints", "context_manifest_fingerprint"],
          "properties": {
            "artifact_fingerprints": {"$ref": "#/$defs/fingerprintArray"},
            "context_manifest_fingerprint": {"anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]}
          }
        },
        "authority": {"const": false}
      }
    },
    "pendingHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_id", "artifact_fingerprints"],
      "properties": {
        "handoff_id": {"type": "string", "minLength": 1},
        "artifact_fingerprints": {"$ref": "#/$defs/fingerprintArray"}
      }
    },
    "safePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "resource_id", "session_id", "run_id", "checkpoint_id", "safe_point_id", "safe_point_kind", "artifact_fingerprints", "context_manifest_fingerprint", "session_payload_hash", "pending_handoffs", "in_consequential_write_transaction", "authority"],
      "properties": {
        "schema": {"const": "novelforge_author_steering_safe_point_v1"},
        "resource_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "checkpoint_id": {"type": "string", "minLength": 1},
        "safe_point_id": {"type": "string", "minLength": 1},
        "safe_point_kind": {"enum": ["between_operations", "before_context_rebuild", "before_draft", "before_review", "after_handoff", "before_runtime_command"]},
        "artifact_fingerprints": {"$ref": "#/$defs/fingerprintArray"},
        "context_manifest_fingerprint": {"anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "session_payload_hash": {"$ref": "#/$defs/fingerprint"},
        "pending_handoffs": {"type": "array", "items": {"$ref": "#/$defs/pendingHandoff"}},
        "in_consequential_write_transaction": {"const": false},
        "authority": {"const": false}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "decision_id", "steering_event_id", "steering_event_fingerprint", "session_id", "run_id", "safe_point_fingerprint", "route", "binding_mode", "authored_against_artifact_fingerprints", "observed_current_artifact_fingerprints", "invalidate_artifact_fingerprints", "cancel_handoff_ids", "rationale_ref", "authority"],
      "properties": {
        "schema": {"const": "novelforge_author_steering_decision_v1"},
        "decision_id": {"type": "string", "minLength": 1},
        "steering_event_id": {"type": "string", "minLength": 1},
        "steering_event_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "session_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "safe_point_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "route": {"enum": ["continue", "rebuild_context", "replan", "regenerate", "cancel_handoff", "await_user", "defer_future"]},
        "binding_mode": {"enum": ["exact", "drift_acknowledged"]},
        "authored_against_artifact_fingerprints": {"$ref": "#/$defs/fingerprintArray"},
        "observed_current_artifact_fingerprints": {"$ref": "#/$defs/fingerprintArray"},
        "invalidate_artifact_fingerprints": {"$ref": "#/$defs/fingerprintArray"},
        "cancel_handoff_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "rationale_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "authority": {"const": false}
      }
    },
    "consumption": {
      "type": "object",
      "required": ["schema", "steering_event_id", "steering_event_fingerprint", "decision_fingerprint", "safe_point_fingerprint", "binding_fingerprint", "session_id", "run_id", "route", "consumed", "already_consumed", "required_follow_up_ops", "follow_up_executed", "replay_safe", "authority", "canon_authority", "framework_write_authority", "project_write_authority", "settlement_authority", "model_execution"],
      "properties": {
        "schema": {"const": "novelforge_author_steering_consumption_v1"},
        "steering_event_id": {"type": "string", "minLength": 1},
        "steering_event_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "decision_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "safe_point_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "binding_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "session_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "route": {"type": "string"},
        "consumed": {"type": "boolean"},
        "already_consumed": {"type": "boolean"},
        "required_follow_up_ops": {"type": "array", "items": {"type": "string"}},
        "follow_up_executed": {"const": false},
        "replay_safe": {"const": true},
        "authority": {"const": false},
        "canon_authority": {"const": false},
        "framework_write_authority": {"const": false},
        "project_write_authority": {"const": false},
        "settlement_authority": {"const": false},
        "model_execution": {"const": false}
      }
    }
  }
}
