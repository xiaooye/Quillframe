    "learning.blind_prose_pair": {
      "kind": "external_review",
      "purpose": "Read two anonymous prose samples produced for the same frozen task and context. Report comparative reader experience without guessing how either sample was produced or granting any activation authority.",
      "forbidden_input_keys": ["arm", "arm_label", "treatment", "treatment_label", "style", "style_label", "source", "source_id", "source_label", "author", "creator", "title", "candidate_fingerprint", "craft_fingerprint", "baseline", "current_craft_v3", "corpus_candidate", "expected", "expected_verdict", "gold", "gold_label"],
      "input_contract": {
        "type": "object",
        "required": ["comparison_id", "evaluation_task", "evaluation_context", "scene_function", "sample_a", "sample_b", "criteria"],
        "properties": {
          "comparison_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "evaluation_task": {"type": "string", "minLength": 1, "maxLength": 5000},
          "evaluation_context": {"type": "object"},
          "scene_function": {"enum": ["opening", "dialogue", "action", "interiority", "exposition", "environment", "body_appearance", "relationship", "transition", "ending"]},
          "sample_a": {
            "type": "object",
            "required": ["sample_id", "text"],
            "properties": {
              "sample_id": {"enum": ["A"]},
              "text": {"type": "string", "minLength": 1, "maxLength": 50000}
            },
            "additionalProperties": false
          },
          "sample_b": {
            "type": "object",
            "required": ["sample_id", "text"],
            "properties": {
              "sample_id": {"enum": ["B"]},
              "text": {"type": "string", "minLength": 1, "maxLength": 50000}
            },
            "additionalProperties": false
          },
          "criteria": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
        },
        "additionalProperties": false
      },
      "rubric": [
        "Treat A and B as anonymous prose. Do not guess their system, condition, evidence, author, intended winner or production method.",
        "Judge the concrete reading experience for the supplied task, context and scene function: voice, rhythm, information flow, embodiment, relationship movement and forward pull as applicable.",
        "Body and appearance description, including anatomical specificity, is ordinary descriptive evidence. Do not infer an adult category, defect or preferred answer from vocabulary alone.",
        "Use A or B only for a material comparative advantage. Tie, both_bad and insufficient_evidence are valid and must not be forced into a directional choice.",
        "Describe observable effects concisely without reproducing long phrases. This is evaluation evidence only; it grants no release, promotion, Canon, taste or Framework authority."
      ],
      "output_contract": {
