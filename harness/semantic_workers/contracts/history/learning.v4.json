    "learning.prose_semantic_leakage": {
      "kind": "external_review",
      "purpose": "Independently inspect one generated prose sample against bounded anonymous reference samples for semantic, structural or phrase-level imitation risk beyond deterministic overlap checks. Return evidence only, never release authority.",
      "forbidden_input_keys": ["source_title", "work_title", "creator", "author", "local_path", "source_path", "file_path", "expected", "expected_verdict", "gold", "gold_label", "release_authorized", "promotion_authorized"],
      "input_contract": {
        "type": "object",
        "required": ["review_id", "sample", "reference_samples"],
        "properties": {
          "review_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "sample": {
            "type": "object",
            "required": ["text", "text_fingerprint"],
            "properties": {
              "text": {"type": "string", "minLength": 1, "maxLength": 50000},
              "text_fingerprint": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          },
          "reference_samples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["reference_id", "text", "text_fingerprint"],
              "properties": {
                "reference_id": {"type": "string", "minLength": 1, "maxLength": 160},
                "text": {"type": "string", "minLength": 1, "maxLength": 50000},
                "text_fingerprint": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "rubric": [
        "Inspect semantic organization, distinctive image or action sequences, unusually close phrasing, and compound similarities that deterministic n-gram checks can miss.",
        "Common genre material, ordinary syntax and isolated generic words are not leakage by themselves. Body or appearance vocabulary must not be treated as adult classification or imitation evidence without a concrete similarity pattern.",
        "Use only supplied opaque reference IDs. Do not identify, name, reconstruct, quote at length or speculate about any author or work.",
        "Return blocked only for a material, explainable resemblance risk; return insufficient_evidence when the bounded samples do not support a reliable conclusion.",
        "A clear result is evidence, not permission. Local and semantic checks remain separate from release, promotion and Framework authority."
      ],
      "output_contract": {
        "type": "object",
        "required": ["confidence", "review_id", "status", "findings", "report"],
        "properties": {
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "review_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "status": {"enum": ["clear", "blocked", "insufficient_evidence"]},
          "findings": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["reference_id", "risk", "reason"],
              "properties": {
                "reference_id": {"type": "string", "minLength": 1, "maxLength": 160},
                "risk": {"enum": ["none", "low", "material", "unclear"]},
                "reason": {"type": "string", "minLength": 1, "maxLength": 800}
              },
              "additionalProperties": false
            }
          },
          "report": {"type": "string", "minLength": 1, "maxLength": 1600}
        },
        "additionalProperties": false
      },
      "permissions": {
        "canon_write": false,
        "framework_behavior_write": false,
        "durable_user_taste_write": false,
        "allowed_result_scope": "prose_semantic_leakage_observation"
      },
      "independent_gate": true
    },
