              "properties": {
                "axis": {"enum": ["voice", "rhythm", "information_flow", "embodiment", "relationship", "forward_pull", "overall_reading"]},
                "leaning": {"enum": ["a", "b", "tie", "unclear"]},
                "observation": {"type": "string", "minLength": 1, "maxLength": 800}
              },
              "additionalProperties": false
            }
          },
          "blindness_concerns": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "report": {"type": "string", "minLength": 1, "maxLength": 1600}
