{
  "schema": "quillframe_model_contract_registry_v1",
  "version": "4",
  "principle": "Adaptive-learning interpretation and evidence sufficiency belong to models; deterministic runtime binds evidence, exact semantic receipts, promotion authority, version/rollback/CI and durable-write permissions. A semantic PASS never grants its own write authority.",
  "contracts": {
    "learning.mechanism_analyze": {
      "kind": "corpus_analyze",
      "purpose": "Analyze bounded, rights-safe corpus evidence for a craft mechanism, counterexample and applicability boundary.",
      "forbidden_input_keys": ["full_text", "raw_text", "source_text"],
      "rubric": [
        "Answer only the supplied research question using the supplied bounded evidence.",
        "Separate observed mechanism from speculation and lower confidence when evidence is weak.",
        "Actively identify counterevidence and a boundary where the mechanism should not generalize.",
        "Do not imitate a named author, infer project Canon, or infer user biography.",
        "Every substantive claim must cite supplied evidence references or fields."
      ],
      "output_contract": {
        "type": "object",
        "required": ["confidence", "mechanisms", "counterexamples", "applicability_boundaries", "evidence_refs"],
        "properties": {
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "mechanisms": {"type": "array"},
          "counterexamples": {"type": "array"},
          "applicability_boundaries": {"type": "array"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      },
      "permissions": {
        "canon_write": false,
        "framework_behavior_write": false,
        "durable_user_taste_write": false,
        "allowed_result_scope": "learning_observation"
      },
      "independent_gate": false
    },
    "learning.promotion_review": {
      "kind": "artifact_audit",
      "purpose": "Judge whether the supplied evidence semantically supports the proposed learning hypothesis at the proposed scope, including contradictions, applicability boundaries and counterexamples, without granting activation or promotion authority.",
      "forbidden_input_keys": ["expected_result", "expected_scope", "write_authorized", "promotion_authorized", "hidden_user_profile"],
      "input_contract": {
        "type": "object",
        "required": ["candidate_id", "scope", "mechanism", "evidence_refs"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "scope": {"enum": ["project", "user_taste", "general_craft"]},
          "mechanism": {"type": "string", "minLength": 1},
          "candidate_artifact_fingerprint": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
          "craft_pack_fingerprint": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
          "statement": {"type": "string"},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_summary": {"type": "array", "items": {"type": "object"}},
          "counterexample_refs": {"type": "array", "items": {"type": "string"}},
          "applicability_boundary": {"type": "object"},
          "contradiction_evidence": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      },
      "rubric": [
        "Judge semantic evidence sufficiency; do not count examples as a proxy for whether they are independent, relevant or consistent.",
        "For user_taste, distinguish an explicit durable preference from one-off frustration, project-local intent and unstable inference. For general_craft, actively test counterexamples and profile boundaries before accepting generalization.",
        "Treat contradictions as semantic evidence to reconcile, not as an integer threshold. Narrow the proposed scope when that is the better supported conclusion.",
        "Return insufficient_evidence rather than inventing stability. A pass means the hypothesis is semantically supportable at the stated scope only; activation/promotion still requires deterministic authority checks outside this contract."
      ],
      "output_contract": {
        "type": "object",
        "required": ["confidence", "result", "supported_scope", "report", "evidence_refs"],
        "properties": {
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "result": {"enum": ["pass", "fail", "insufficient_evidence"]},
          "supported_scope": {"enum": ["project", "user_taste", "general_craft", "one_off", "narrower_than_proposed"]},
          "report": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "unresolved_contradictions": {"type": "array", "items": {"type": "string"}},
          "recommended_boundary": {"type": "object"}
        },
        "additionalProperties": false
      },
      "permissions": {
        "canon_write": false,
        "framework_behavior_write": false,
        "durable_user_taste_write": false,
        "allowed_result_scope": "learning_promotion_semantic_review"
      },
      "independent_gate": false
    },
    "learning.evaluate": {
      "kind": "eval_judge",
      "purpose": "Evaluate a proposed learned mechanism against the supplied bounded test fixture and profile boundary without seeing hidden expected labels.",
      "input_contract": {
        "type": "object",
        "required": ["mechanism", "fixture"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "scope": {"enum": ["project", "user_taste", "general_craft"]},
          "learning_scope": {"enum": ["one_off", "project", "user_taste", "general_craft"]},
          "hypothesis_id": {"type": ["string", "null"]},
          "mechanism": {"type": ["string", "null"]},
          "profile_boundary": {"type": "object"},
          "fixture": {"oneOf": [{"type": "object"}, {"type": "string", "minLength": 1}]},
          "evaluation_purpose": {"type": ["string", "null"]},
          "evaluation_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "candidate_artifact_fingerprint": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
          "craft_pack_fingerprint": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      },
      "rubric": [
        "Apply only the evaluation purpose and criteria supplied in the payload.",
        "Judge whether the proposed mechanism works for this fixture without turning a profile-sensitive preference into a universal hard rule.",
        "Use observable evidence and return concise failure codes when the mechanism fails.",
        "Do not search for expected labels or hidden gold.",
        "This judgment may support a promotion gate but never grants promotion/write authority by itself."
      ],
      "output_contract": {
        "type": "object",
        "required": ["confidence", "result", "codes", "evidence"],
        "properties": {
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "result": {"enum": ["pass", "fail"]},
          "codes": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      },
      "permissions": {
        "canon_write": false,
        "framework_behavior_write": false,
        "durable_user_taste_write": false,
        "allowed_result_scope": "learning_eval_observation"
      },
      "independent_gate": true
    },
    "corpus.range_observe": {
      "kind": "corpus_analyze",
      "purpose": "Observe transferable craft mechanisms in one ephemeral, bounded fiction passage. The passage may be present only for this invocation; output must contain abstract observations and opaque references, never quotations or source identity.",
      "forbidden_input_keys": ["full_text", "source_title", "creator", "author", "local_path", "source_path"],
      "input_contract": {
        "type": "object",
        "required": ["range_id", "window_role", "passage", "research_axes", "passage_fingerprint"],
        "properties": {
          "range_id": {"type": "string", "minLength": 1},
          "window_role": {"enum": ["opening", "representative_middle", "chapter_ending"]},
          "passage": {"type": "string", "minLength": 1, "maxLength": 4000},
          "passage_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "research_axes": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["scene_entry", "causal_progression", "dialogue_voice", "interiority_distance", "information_timing", "paragraph_rhythm", "relationship_movement", "chapter_forward_pull"]}
          }
        },
        "additionalProperties": false
      },
      "rubric": [
        "Describe observable, transferable mechanisms at sentence_or_paragraph, scene or chapter level. Never quote, closely paraphrase, identify or imitate the source or author.",
        "For each mechanism state its effect, enabling conditions, a failure or legitimate counterexample boundary, and calibrated confidence. Do not convert counts, sentence lengths or beat patterns into generation quotas.",
        "Treat summary, complete professional speech, interiority and metaphor as potentially legitimate. Diagnose their function in this passage instead of applying a blacklist.",
        "Information-through-action, identity-constrained dialogue, embodied presence, causal consequence and forward pull are research questions, not expected labels. Return contrary evidence when present."
      ],
      "output_contract": {
        "type": "object",
        "required": ["confidence", "range_id", "observations", "counterexamples", "uncertainties"],
        "properties": {
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "range_id": {"type": "string", "minLength": 1},
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["level", "axis", "mechanism", "observed_effect", "conditions", "failure_boundary", "confidence"],
              "properties": {
                "level": {"enum": ["sentence_or_paragraph", "scene", "chapter"]},
                "axis": {"enum": ["scene_entry", "causal_progression", "dialogue_voice", "interiority_distance", "information_timing", "paragraph_rhythm", "relationship_movement", "chapter_forward_pull"]},
                "mechanism": {"type": "string", "minLength": 1},
                "observed_effect": {"type": "string", "minLength": 1},
                "conditions": {"type": "array", "items": {"type": "string"}},
                "failure_boundary": {"type": "string", "minLength": 1},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "additionalProperties": false
            }
          },
          "counterexamples": {"type": "array", "items": {"type": "string"}},
          "uncertainties": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      },
      "permissions": {
        "canon_write": false,
        "framework_behavior_write": false,
        "durable_user_taste_write": false,
        "allowed_result_scope": "ephemeral_range_observation"
      },
      "independent_gate": false
    },
    "learning.work_synthesize": {
      "kind": "corpus_analyze",
      "purpose": "Synthesize three already-derived window observations for one opaque logical work without receiving source prose or source identity.",
      "forbidden_input_keys": ["passage", "excerpt", "full_text", "raw_text", "source_text", "source_title", "creator", "author", "local_path", "source_path"],
      "input_contract": {
        "type": "object",
        "required": ["public_work_id", "window_observations", "research_axes"],
        "properties": {
          "public_work_id": {"type": "string", "minLength": 1},
          "window_observations": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object"}},
          "research_axes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      },
      "rubric": [
        "Synthesize only supported abstract mechanisms and preserve differences among opening, middle and ending windows.",
        "Do not invent source facts, names, plot summaries, phrases or author identity. Preserve counterexamples, uncertainty and profile-sensitive boundaries.",
        "Return coarse, transferable observations rather than exact stylistic measurements or generation quotas."
      ],
      "output_contract": {
        "type": "object",
        "required": ["confidence", "public_work_id", "mechanisms", "counterexamples", "profile_boundaries", "uncertainties"],
        "properties": {
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "public_work_id": {"type": "string", "minLength": 1},
          "mechanisms": {"type": "array", "items": {"type": "object"}},
          "counterexamples": {"type": "array", "items": {"type": "object"}},
          "profile_boundaries": {"type": "array", "items": {"type": "object"}},
          "uncertainties": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      },
      "permissions": {
        "canon_write": false,
        "framework_behavior_write": false,
        "durable_user_taste_write": false,
        "allowed_result_scope": "derived_work_observation"
      },
      "independent_gate": false
    },
    "learning.benchmark_synthesize": {
      "kind": "corpus_analyze",
      "purpose": "Synthesize anonymous, derived work observations into falsifiable cross-work general-craft benchmarks with explicit counterexamples and profile boundaries.",
      "forbidden_input_keys": ["passage", "excerpt", "full_text", "raw_text", "source_text", "source_title", "creator", "author", "local_path", "source_path", "content_fingerprint"],
      "input_contract": {
        "type": "object",
        "required": ["corpus_version", "work_observations", "research_axes"],
        "properties": {
          "corpus_version": {"type": "string", "minLength": 1},
          "work_observations": {"type": "array", "minItems": 2, "items": {"type": "object"}},
          "research_axes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      },
      "rubric": [
        "Each proposed benchmark must cite multiple distinct opaque work IDs, at least one counterexample work ID, and a meaningful profile/applicability boundary.",
        "Separate common mechanism from surface coincidence. Do not create named-author profiles, signature fingerprints, phrase libraries, exact beat quotas or a single quality score.",
        "A benchmark is evidence for later evaluation, not framework guidance or promotion authority. Return contested or narrow results when evidence does not generalize."
      ],
      "output_contract": {
        "type": "object",
        "required": ["confidence", "benchmarks", "contested_questions"],
        "properties": {
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "benchmarks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["mechanism", "problem", "positive_pattern", "failure_boundary", "profiles", "supporting_work_ids", "counterexample_work_ids", "writer_guidance"],
              "properties": {
                "mechanism": {"type": "string", "minLength": 1},
                "problem": {"type": "string", "minLength": 1},
                "positive_pattern": {"type": "string", "minLength": 1},
                "failure_boundary": {"type": "string", "minLength": 1},
                "profiles": {"type": "array", "items": {"type": "string"}},
                "supporting_work_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
                "counterexample_work_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
                "writer_guidance": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "contested_questions": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      },
      "permissions": {
        "canon_write": false,
        "framework_behavior_write": false,
        "durable_user_taste_write": false,
        "allowed_result_scope": "cross_work_benchmark_candidates"
      },
      "independent_gate": false
    },
    "corpus.style_observe": {
      "kind": "corpus_analyze",
      "purpose": "Observe transferable prose-style operations in one ephemeral, scene-aware passage. Return only source-free claims bound to opaque local span references; never quote, closely paraphrase, identify or imitate the source.",
      "forbidden_input_keys": ["full_text", "raw_text", "source_text", "source_title", "creator", "author", "local_path", "source_path", "work_title"],
      "input_contract": {
        "type": "object",
        "required": ["style_range_id", "scene_function", "passage", "passage_fingerprint", "paragraph_spans", "style_axes", "content_profile"],
        "properties": {
          "style_range_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "scene_function": {"enum": ["opening", "dialogue", "action", "interiority", "exposition", "environment", "body_appearance", "relationship", "transition", "ending"]},
          "passage": {"type": "string", "minLength": 1, "maxLength": 3000},
          "passage_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "paragraph_spans": {
            "type": "array", "minItems": 1, "maxItems": 64,
            "items": {
              "type": "object",
              "required": ["span_ref", "start", "end"],
              "properties": {
                "span_ref": {"type": "string", "minLength": 1, "maxLength": 80},
                "start": {"type": "integer", "minimum": 0},
                "end": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            }
          },
          "style_axes": {
            "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
            "items": {"enum": ["prose_voice", "syntax_rhythm", "lexical_register", "psychic_distance", "descriptive_attention", "body_appearance", "imagery", "dialogue_voice", "interiority_summary", "information_flow"]}
          },
          "content_profile": {"enum": ["general", "adult_explicit"]}
        },
        "additionalProperties": false
      },
      "rubric": [
        "Treat style as several interacting, scene-conditioned operations rather than an author identity, a single score or an average sentence-length target.",
        "For every observation name the operation, its observable effect, when it helps, when it should be avoided, a legitimate failure or counterexample boundary, and only supplied local span_ref evidence.",
        "Separate style from story content, named entities, setting facts and signature phrases. A claim that depends on those features must be returned as uncertainty rather than a transferable mechanism.",
        "Body, appearance, clothing and anatomical specificity are legitimate descriptive-attention evidence. Do not classify a passage as adult merely because such description exists; content_profile is already frozen by the caller.",
        "Never quote or closely paraphrase the passage. Do not emit source names, plot summaries, character facts, generation quotas, imitation instructions or private reasoning."
      ],
      "output_contract": {
        "type": "object",
        "required": ["confidence", "style_range_id", "observations", "counterexamples", "coverage", "uncertainties"],
        "properties": {
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "style_range_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "observations": {
            "type": "array", "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["axis", "level", "operation", "observed_effect", "applies_when", "avoid_when", "failure_boundary", "content_zone", "evidence_span_refs", "confidence"],
              "properties": {
                "axis": {"enum": ["prose_voice", "syntax_rhythm", "lexical_register", "psychic_distance", "descriptive_attention", "body_appearance", "imagery", "dialogue_voice", "interiority_summary", "information_flow"]},
                "level": {"enum": ["sentence", "paragraph", "scene", "chapter"]},
                "operation": {"type": "string", "minLength": 1, "maxLength": 800},
                "observed_effect": {"type": "string", "minLength": 1, "maxLength": 800},
                "applies_when": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
                "avoid_when": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
                "failure_boundary": {"type": "string", "minLength": 1, "maxLength": 800},
                "content_zone": {"enum": ["general", "adult_explicit", "profile_neutral"]},
                "evidence_span_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "additionalProperties": false
            }
          },
          "counterexamples": {"type": "array", "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 600}},
          "coverage": {
            "type": "object",
            "required": ["axes_observed", "scene_function_supported"],
            "properties": {
              "axes_observed": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
              "scene_function_supported": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "uncertainties": {"type": "array", "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 600}}
        },
        "additionalProperties": false
      },
      "permissions": {
        "canon_write": false,
        "framework_behavior_write": false,
        "durable_user_taste_write": false,
        "allowed_result_scope": "ephemeral_style_observation"
      },
      "independent_gate": false
    },
    "learning.style_work_synthesize": {
      "kind": "corpus_analyze",
      "purpose": "Infer stable style operations, local variants, counterexamples and unresolved coverage for one opaque work from already-derived scene-aware observations, without source prose or identity.",
      "forbidden_input_keys": ["passage", "excerpt", "full_text", "raw_text", "source_text", "source_title", "creator", "author", "local_path", "source_path", "work_title"],
      "input_contract": {
        "type": "object",
        "required": ["public_work_id", "analysis_round", "style_axes", "scene_functions_sampled", "window_observations", "content_profile"],
        "properties": {
          "public_work_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "analysis_round": {"type": "integer", "minimum": 1, "maximum": 4},
          "style_axes": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
          "scene_functions_sampled": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
          "window_observations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object"}},
          "content_profile": {"enum": ["general", "adult_explicit"]}
        },
        "additionalProperties": false
      },
      "rubric": [
        "Distinguish a stable recurring operation from a local scene variant, a genre/content coincidence and a legitimate counterexample.",
        "Use only opaque range/span/work references supplied by the caller. Never reconstruct source prose, identity, plot, named entities or signature phrases.",
        "Request another scene function only when it could materially resolve an explicit uncertainty. No fixed sample count proves saturation.",
        "Body and appearance mechanisms remain ordinary descriptive-attention evidence; do not infer or change the frozen content profile."
      ],
      "output_contract": {
        "type": "object",
        "required": ["confidence", "public_work_id", "stable_patterns", "local_variants", "counterexamples", "coverage_gaps", "saturation", "uncertainties"],
        "properties": {
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "public_work_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "stable_patterns": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
          "local_variants": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
          "counterexamples": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
          "coverage_gaps": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"enum": ["opening", "dialogue", "action", "interiority", "exposition", "environment", "body_appearance", "relationship", "transition", "ending"]}},
          "saturation": {
            "type": "object",
            "required": ["state", "reason"],
            "properties": {
              "state": {"enum": ["continue", "saturated", "insufficient_available_evidence"]},
              "reason": {"type": "string", "minLength": 1, "maxLength": 800}
            },
            "additionalProperties": false
          },
          "uncertainties": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 600}}
        },
        "additionalProperties": false
      },
      "permissions": {
        "canon_write": false,
        "framework_behavior_write": false,
        "durable_user_taste_write": false,
        "allowed_result_scope": "derived_style_work_profile"
      },
      "independent_gate": false
    },
    "learning.style_axis_synthesize": {
      "kind": "corpus_analyze",
      "purpose": "Synthesize one style axis from a bounded discovery batch of anonymous work profiles into falsifiable, source-free candidate claims without averaging distinct styles into one voice.",
      "forbidden_input_keys": ["passage", "excerpt", "full_text", "raw_text", "source_text", "source_title", "creator", "author", "local_path", "source_path", "work_title"],
      "input_contract": {
        "type": "object",
        "required": ["axis", "batch_id", "content_profile", "discovery_work_profiles"],
        "properties": {
          "axis": {"enum": ["prose_voice", "syntax_rhythm", "lexical_register", "psychic_distance", "descriptive_attention", "body_appearance", "imagery", "dialogue_voice", "interiority_summary", "information_flow"]},
          "batch_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "content_profile": {"enum": ["general", "adult_explicit"]},
          "discovery_work_profiles": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"type": "object"}}
        },
        "additionalProperties": false
      },
      "rubric": [
        "Produce several conditional mechanisms when evidence clusters differ; never collapse the corpus into a single preferred voice or quality score.",
        "Each claim must cite at least two supplied opaque work IDs and at least one supplied counterexample work ID. Treat support count as evidence coverage, not semantic truth.",
        "Separate style from characters, setting, topic, plot and author identity. Do not emit quotes, signature phrases, named-author instructions or generation quotas.",
        "Return narrow or contested claims when applicability differs by scene function, point of view, genre/profile or desired reader effect."
      ],
      "output_contract": {
        "type": "object",
        "required": ["confidence", "axis", "claims", "contested_questions"],
        "properties": {
