{
  "schema": "novelforge_model_contract_registry_v1",
  "version": "4",
  "principle": "Production-loop semantic artifacts stay thin. Models interpret feedback, causal scene state, current objective preservation and repair strategy; machines consume only the small fields needed for authority-safe persistence or routing. Private character state may drive semantic decisions but is not prose payload, and rejected repair trajectories do not become the fresh Writer objective.",
  "contracts": {
    "learning.preference_interpret": {
      "kind": "artifact_audit",
      "purpose": "Interpret explicit user review feedback into the narrowest evidence-backed preference/repair hypothesis without granting durable preference authority.",
      "forbidden_input_keys": [
        "user_biography",
        "private_profile",
        "hidden_memory",
        "framework_promotion_target",
        "expected_scope"
      ],
      "input_contract": {
        "type": "object",
        "required": [
          "feedback_ref",
          "feedback_text",
          "current_task"
        ],
        "properties": {
          "feedback_ref": {
            "type": "string",
            "minLength": 1
          },
          "feedback_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "current_task": {
            "type": "object"
          },
          "project_profile": {
            "type": "object"
          },
          "active_author_model": {
            "type": "object"
          },
          "candidate_excerpt": {
            "type": "string",
            "maxLength": 12000
          }
        },
        "additionalProperties": false
      },
      "rubric": [
        "Treat the user's supplied feedback as primary evidence. Do not infer biography, identity, stable taste or universal craft law beyond the evidence.",
        "Separate immediate repair from any future preference hypothesis and choose the narrowest plausible scope.",
        "Describe the semantic mechanism in natural language; preserve exceptions and uncertainty rather than manufacturing a complete preference record.",
        "If supplied active hypotheses materially conflict with this evidence, identify them. This is evidence only and grants no durable authority."
      ],
      "output_contract": {
        "type": "object",
        "required": [
          "scope_candidate",
          "dimension",
          "mechanism",
          "statement",
          "polarity",
          "confidence",
          "evidence_source",
          "desired_behavior",
          "avoid_behavior",
          "exceptions",
          "contradicts_hypothesis_ids"
        ],
        "properties": {
          "scope_candidate": {
            "enum": [
              "one_off",
              "project",
              "user_taste",
              "general_craft"
            ]
          },
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "observed_problem": {
            "type": [
              "string",
              "null"
            ]
          },
          "polarity": {
            "enum": [
              "positive",
              "negative",
              "mixed"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_source": {
            "enum": [
              "explicit_rule",
              "user_edit",
              "rejection",
              "acceptance",
              "repeated_pattern",
              "human_review"
            ]
          },
          "desired_behavior": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "avoid_behavior": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "applicability": {
            "type": "object"
          },
          "contradicts_hypothesis_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "permissions": {
        "canon_write": false,
        "framework_behavior_write": false,
        "durable_user_taste_write": false,
        "allowed_result_scope": "preference_observation_proposal"
      },
      "independent_gate": false
    },
    "scene.realization_project": {
      "kind": "artifact_audit",
      "purpose": "Convert private character/action evidence and resolved scene trajectory into the minimum writer-safe causal trace needed to realize prose, without serializing Character Sheets or a replacement Realization Sheet.",
      "input_contract": {
        "type": "object",
        "required": [
          "scene_id",
          "resolved_trajectory",
          "character_action_evidence",
          "pov_boundary"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "resolved_trajectory": {
            "type": "object"
          },
          "character_action_evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "pov_boundary": {
            "type": "object"
          },
          "relationship_context": {
            "type": "object"
          },
          "task_context": {
            "type": "object"
          },
          "project_profile": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "rubric": [
        "Use private character state as causal evidence only. Do not dump goals, fears, role responsibilities, knowledge inventories or strategy rationale into writer-facing prose instructions.",
        "Return the smallest interaction/event trace that preserves what changed, what is observable, what each important action is trying to accomplish, and what uncertainty or pressure remains alive.",
        "Do not draft final dialogue or narration. Do not force every private field to have a corresponding writer-facing field.",
        "Explicit complete speech is valid when the speech act or situation genuinely requires completeness. Preserve that reason in the natural-language trace when material.",
        "If the resolved trajectory is already sufficient for a capable Writer, keep the projection compact rather than inventing additional schema detail."
      ],
      "output_contract": {
        "type": "object",
        "required": [
          "confidence",
          "scene_id",
          "interaction_trace",
          "writer_context"
        ],
        "properties": {
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "interaction_trace": {
            "type": "string",
            "minLength": 1
          },
          "writer_context": {
            "type": "string",
            "minLength": 1
          },
          "observable_event_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unresolved_pressures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "permissions": {
        "canon_write": false,
        "framework_behavior_write": false,
        "durable_user_taste_write": false,
        "allowed_result_scope": "writer_safe_realization_projection"
      },
      "independent_gate": false
    },
    "editor.repair_spec": {
      "kind": "artifact_audit",
      "purpose": "Editor integrates bounded Reader/rule findings, authorized story evidence and the current objective envelope, then emits a FIX+PRESERVE repair specification and chooses local repair versus fresh reconstructed realization. Python enforces the chosen information boundary but does not infer literary repair depth.",
      "input_contract": {
        "type": "object",
        "required": [
          "candidate_fingerprint",
          "reader_assessment",
          "objective_envelope"
        ],
        "properties": {
          "candidate_fingerprint": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71
          },
          "reader_assessment": {
            "type": "object"
          },
          "semantic_rule_assessment": {
            "type": "object"
          },
          "current_repair_goal": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_profile": {
            "type": "object"
          },
          "author_model_projection": {
            "type": "object"
          },
          "authorized_story_evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "objective_envelope": {
            "type": "object",
            "required": [
              "fingerprint",
              "objective_items",
              "must_preserve"
            ],
            "properties": {
              "fingerprint": {
                "type": "string",
                "minLength": 71,
                "maxLength": 71
              },
              "objective_items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object"
                }
              },
              "must_preserve": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "supersedes_fingerprint": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "change_authority_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "rubric": [
        "Integrate evidence before prescribing repair. The repair target and the higher-order objective are separate: removing a defect is not success if required story/reader/character value is materially damaged.",
        "Return a FIX statement for the owning failure mechanism and a compact PRESERVE list grounded in the supplied objective envelope. Preserve function, reader question/pressure/reward, character or relationship energy, humor/charm, payoff and forward pull only when they are actually required by current evidence.",
        "Choose repair depth and generation mode semantically. Do not map a Reader label, HF code, owner, scope, paragraph count, repair-cycle count or metric to a predetermined local/fresh decision table.",
        "Choose fresh_realization when rejected realization or accumulated critique is likely to anchor the Writer, or when objective regression/contextual inertia/oscillation makes patch continuation unsafe. A fresh realization reconstructs current authoritative state; it does not append the full rejection trajectory.",
        "Do not solve objective regression by weakening valid Surface/Canon/character constraints. Search for a candidate that satisfies both the repair target and the preserved objective.",
        "For material subjective changes, require incumbent/challenger comparison. Do not assume revision is improvement, and do not require wording or beat-order preservation when a major fresh realization keeps the intended functions.",
        "Do not perform the rewrite, mutate Canon, activate Author Model preferences or expose private chain-of-thought."
      ],
      "output_contract": {
        "type": "object",
        "required": [
          "confidence",
          "repair_owner",
          "generation_mode",
          "fix",
          "repair_plan",
          "preserve",
          "comparison_required"
        ],
        "properties": {
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "repair_owner": {
            "enum": [
              "story",
              "plan",
              "scene",
              "character",
              "reader_pressure",
              "surface",
              "continuity",
              "context",
              "research",
              "runtime",
              "human"
            ]
          },
          "generation_mode": {
            "enum": [
              "local_or_bounded_repair",
              "fresh_realization"
            ]
          },
          "repair_plan": {
            "type": "string",
            "minLength": 1
          },
          "preserve": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "comparison_required": {
            "type": "boolean"
          },
          "invalidate_artifact_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fix": {
            "type": "string",
            "minLength": 1
          },
          "context_strategy_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "permissions": {
        "canon_write": false,
        "framework_behavior_write": false,
        "durable_user_taste_write": false,
        "allowed_result_scope": "repair_specification"
      },
      "independent_gate": false
    }
  }
}
