{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novelforge-semantic-run-receipt-v1",
  "title": "NovelForge Semantic Run Receipt",
  "description": "Provider-neutral, non-authoritative trace of one bounded semantic workflow. It links sparse context, selected contract packs, fingerprint-bound model calls, artifacts and decisions without becoming Canon or a replacement for Session/Control Plane state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "workflow_name",
    "subject_id",
    "task_mode",
    "context",
    "pack_activations",
    "steps",
    "artifacts",
    "decisions",
    "status",
    "authority",
    "permissions"
  ],
  "properties": {
    "schema": {"const": "novelforge_semantic_run_receipt_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "session_id": {"type": ["string", "null"]},
    "workflow_name": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "task_mode": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_ref", "manifest_fingerprint", "authority_snapshot"],
      "properties": {
        "manifest_ref": {"type": "string", "minLength": 1},
        "manifest_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "authority_snapshot": {"type": "string", "minLength": 1}
      }
    },
    "pack_activations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pack_id", "registry_path", "reason", "selected_by"],
        "properties": {
          "pack_id": {"type": "string", "minLength": 1},
          "registry_path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "selected_by": {"enum": ["model", "manager", "explicit_user", "runtime_required"]}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "contract_id",
          "pack_id",
          "parent_step_ids",
          "input_fingerprint",
          "status",
          "worker",
          "result_fingerprint",
          "authority"
        ],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "contract_id": {"type": "string", "minLength": 1},
          "pack_id": {"type": "string", "minLength": 1},
          "parent_step_ids": {"type": "array", "items": {"type": "string"}},
          "input_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "status": {"enum": ["completed", "semantic_reject", "semantic_pending", "failed", "skipped"]},
          "worker": {
            "type": ["object", "null"],
            "properties": {
              "provider": {"type": "string"},
              "model_or_reviewer": {"type": "string"},
              "worker_session_id": {"type": ["string", "null"]},
              "run_reference": {"type": ["string", "null"]}
            }
          },
          "result_fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "artifact_refs": {"type": "array", "items": {"type": "string"}},
          "finding_refs": {"type": "array", "items": {"type": "string"}},
          "decision_refs": {"type": "array", "items": {"type": "string"}},
          "authority": {"const": false}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_ref", "fingerprint", "role", "authority"],
        "properties": {
          "artifact_ref": {"type": "string", "minLength": 1},
          "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "role": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "kind", "source_step_ids", "value", "authority"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "source_step_ids": {"type": "array", "items": {"type": "string"}},
          "value": {},
          "authority": {"const": false}
        }
      }
    },
    "status": {"enum": ["running", "awaiting_semantic", "failed_gate", "ready_for_user_gate", "completed"]},
    "authority": {"const": false},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canon_write", "framework_write", "durable_user_taste_write"],
      "properties": {
        "canon_write": {"const": false},
        "framework_write": {"const": false},
        "durable_user_taste_write": {"const": false}
      }
    },
    "model_execution": {"type": "boolean"},
    "provenance": {"type": "object"}
  }
}
