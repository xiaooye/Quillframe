{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novelforge_story_workspace_v1",
  "title": "NovelForge Story Workspace Projection",
  "type": "object",
  "required": ["schema", "workspace_fingerprint", "project", "sections", "object_count", "lifecycle_counts", "authority_classes_preserved", "parallel_canon_store", "authority", "canon_write", "settlement_authority", "model_execution"],
  "properties": {
    "schema": {"const": "novelforge_story_workspace_v1"},
    "workspace_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "project": {
      "type": "object",
      "required": ["project_id", "project_title", "layout", "framework_lock"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "project_title": {"type": "string", "minLength": 1},
        "project_version": {"type": ["string", "null"]},
        "layout": {"enum": ["standard", "mapped"]},
        "framework_lock": {"type": "object"}
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "required": ["structure", "timeline", "characters", "relationships", "world_state", "plans", "reader_expectations", "context", "branches", "other"],
      "additionalProperties": false,
      "properties": {
        "structure": {"$ref": "#/$defs/objectList"},
        "timeline": {"$ref": "#/$defs/objectList"},
        "characters": {"$ref": "#/$defs/objectList"},
        "relationships": {"$ref": "#/$defs/objectList"},
        "world_state": {"$ref": "#/$defs/objectList"},
        "plans": {"$ref": "#/$defs/objectList"},
        "reader_expectations": {"$ref": "#/$defs/objectList"},
        "context": {"$ref": "#/$defs/objectList"},
        "branches": {"$ref": "#/$defs/objectList"},
        "other": {"$ref": "#/$defs/objectList"}
      }
    },
    "object_count": {"type": "integer", "minimum": 0},
    "lifecycle_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "authority_classes_preserved": {"const": true},
    "parallel_canon_store": {"const": false},
    "authority": {"const": false},
    "canon_write": {"const": false},
    "settlement_authority": {"const": false},
    "model_execution": {"const": false}
  },
  "$defs": {
    "workspaceObject": {
      "type": "object",
      "required": ["id", "section", "kind", "source_ref", "source_fingerprint", "authority_class", "lifecycle", "metadata", "authority"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "section": {"enum": ["structure", "timeline", "characters", "relationships", "world_state", "plans", "reader_expectations", "context", "branches", "other"]},
        "kind": {"type": "string", "minLength": 1},
        "label": {"type": ["string", "null"]},
        "source_ref": {"type": "string", "minLength": 1},
        "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "authority_class": {"enum": ["locked", "accepted", "active_plan", "review", "proposal", "derived", "scenario"]},
        "lifecycle": {"enum": ["locked", "accepted", "active_plan", "review", "proposal", "derived", "scenario"]},
        "story_order": {"type": ["integer", "null"]},
        "metadata": {"type": "object"},
        "authority": {"const": false}
      },
      "additionalProperties": false
    },
    "objectList": {"type": "array", "items": {"$ref": "#/$defs/workspaceObject"}}
  },
  "additionalProperties": false
}
