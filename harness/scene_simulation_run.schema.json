{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novelforge_scene_simulation_run_v1",
  "title": "NovelForge Scene Simulation Run",
  "type": "object",
  "required": ["schema", "run_id", "scene_id", "base_checkpoint_id", "base_state_fingerprint", "character_results", "scene_resolution", "event_ir_candidates", "branches", "run_fingerprint", "agent_topology", "persistent_character_agent_memory", "authority", "canon_write", "settlement_authority", "model_execution"],
  "properties": {
    "schema": {"const": "novelforge_scene_simulation_run_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "base_checkpoint_id": {"type": "string", "minLength": 1},
    "base_state_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "character_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/semanticResult"}},
    "scene_resolution": {"$ref": "#/$defs/semanticResult"},
    "event_ir_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "event_fingerprint", "story_order"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "event_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "story_order": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["branch_id", "branch_fingerprint", "base_state_fingerprint", "selected", "authority"],
        "properties": {
          "branch_id": {"type": "string", "minLength": 1},
          "branch_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "base_state_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "selected": {"type": "boolean"},
          "authority": {"const": false}
        },
        "additionalProperties": false
      }
    },
    "comparison_result": {"type": ["object", "null"]},
    "run_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "agent_topology": {"const": "one_manager_bounded_semantic_invocations"},
    "persistent_character_agent_memory": {"const": false},
    "authority": {"const": false},
    "canon_write": {"const": false},
    "settlement_authority": {"const": false},
    "model_execution": {"const": false}
  },
  "$defs": {
    "semanticResult": {
      "type": "object",
      "required": ["contract_id", "input_fingerprint", "result_fingerprint", "result", "provenance"],
      "properties": {
        "character_id": {"type": "string"},
        "contract_id": {"type": "string", "minLength": 1},
        "input_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "result_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "result": {"type": "object"},
        "provenance": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
