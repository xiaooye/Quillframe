{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novelforge_session_terminate_command_v1",
  "title": "NovelForge Session Terminate Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command_id",
    "action",
    "mode",
    "session_id",
    "expected_before_state",
    "preflight",
    "idempotency_key",
    "authority"
  ],
  "properties": {
    "schema": {"const": "novelforge_session_terminate_command_v1"},
    "command_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "action": {"const": "session.terminate"},
    "mode": {"const": "terminate_session_and_active_run"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "expected_before_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_version", "session_payload_hash", "session_status", "run_id", "run_status"],
      "properties": {
        "session_version": {"type": "integer", "minimum": 1},
        "session_payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "session_status": {"type": "string", "minLength": 1},
        "run_id": {"type": ["string", "null"], "minLength": 1},
        "run_status": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_fingerprint"],
      "properties": {
        "result_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "idempotency_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority": {"const": false}
  }
}
