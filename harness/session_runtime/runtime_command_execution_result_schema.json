{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novelforge_runtime_command_execution_result_v1",
  "title": "NovelForge Runtime Command Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "failure_class",
    "errors",
    "receipt",
    "preflight",
    "command_fingerprint",
    "intent_fingerprint",
    "authorization_fingerprint",
    "replayed_receipt",
    "runtime_mutation_performed",
    "model_execution",
    "authority",
    "project_write_authority",
    "canon_authority",
    "framework_write_authority",
    "settlement_authority",
    "result_fingerprint"
  ],
  "properties": {
    "schema": {"const": "novelforge_runtime_command_execution_result_v1"},
    "status": {"enum": ["applied", "duplicate", "rejected", "conflict", "failed"]},
    "failure_class": {"type": ["string", "null"]},
    "errors": {"type": "array", "items": {"type": "string"}},
    "receipt": {"type": ["object", "null"]},
    "preflight": {"type": ["object", "null"]},
    "command_fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "intent_fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "authorization_fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "replayed_receipt": {"type": "boolean"},
    "runtime_mutation_performed": {"type": "boolean"},
    "model_execution": {"const": false},
    "authority": {"const": false},
    "project_write_authority": {"const": false},
    "canon_authority": {"const": false},
    "framework_write_authority": {"const": false},
    "settlement_authority": {"const": false},
    "result_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
