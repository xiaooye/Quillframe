{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quillframe_property_write_policy_v1",
  "title": "Quillframe Property Write Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "default"],
  "properties": {
    "schema": {"const": "quillframe_property_write_policy_v1"},
    "default": {"$ref": "#/$defs/rule"},
    "object_types": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/objectPolicy"},
      "default": {}
    }
  },
  "$defs": {
    "mutationClass": {
      "enum": [
        "user_declared",
        "settlement_only",
        "derived_only",
        "proposal_only",
        "runtime_only",
        "locked",
        "mixed_reconcile"
      ]
    },
    "rule": {
      "oneOf": [
        {"$ref": "#/$defs/mutationClass"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutation_class"],
          "properties": {"mutation_class": {"$ref": "#/$defs/mutationClass"}}
        }
      ]
    },
    "objectPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {"$ref": "#/$defs/rule"},
        "properties": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/rule"},
          "default": {}
        }
      }
    }
  }
}
