{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novelforge_event_ir_v1",
  "title": "NovelForge Event IR",
  "type": "object",
  "required": ["schema", "event_id", "scene_id", "story_order", "actors", "preconditions", "intent", "action", "obstacle", "response", "consequence", "state_delta", "knowledge_delta", "relationship_delta", "resource_delta", "reader_reward", "source_refs", "evidence_refs", "subject_fingerprint", "event_fingerprint", "authority", "canon_write", "settlement_authority"],
  "properties": {
    "schema": {"const": "novelforge_event_ir_v1"},
    "event_id": {"type": "string", "minLength": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "story_order": {"type": "integer", "minimum": 0},
    "actors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "preconditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "intent": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "obstacle": {"type": "string", "minLength": 1},
    "response": {"type": "string", "minLength": 1},
    "consequence": {"type": "string", "minLength": 1},
    "state_delta": {"$ref": "#/$defs/deltaList"},
    "knowledge_delta": {"$ref": "#/$defs/deltaList"},
    "relationship_delta": {"$ref": "#/$defs/deltaList"},
    "resource_delta": {"$ref": "#/$defs/deltaList"},
    "reader_question_before": {"type": ["string", "null"]},
    "reader_question_after": {"type": ["string", "null"]},
    "reader_reward": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "subject_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "event_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority": {"const": false},
    "canon_write": {"const": false},
    "settlement_authority": {"const": false}
  },
  "$defs": {
    "delta": {
      "type": "object",
      "required": ["subject_id", "field", "evidence_refs", "metadata"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "before": {},
        "after": {},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "deltaList": {"type": "array", "items": {"$ref": "#/$defs/delta"}}
  },
  "additionalProperties": false
}
