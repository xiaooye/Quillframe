    "weiui_generic_foundation": true,
    "weiui_product_identity_authority": false,
    "core_runtime_authority": false,
    "canon_authority": false
  },
  "consumption": {
    "phase_2c_framework": "SolidJS",
    "allowed_packages": ["@weiui/tokens", "@weiui/css"],
    "forbidden_runtime_packages": ["@weiui/headless", "@weiui/react"],
    "theme_layer": "wui-theme",
    "runtime_javascript_from_weiui": false,
    "css_delivery": {
      "mode": "config_generated_checked_in",
      "config_schema": "weiui_css_config_v1",
      "config_path": "studio/app/weiui.config.json",
      "manifest_schema": "weiui_css_bundle_manifest_v1",
      "generator_api": "@weiui/css/config",
      "generator_cli": "weiui-css",
      "generated_css": "studio/app/src/styles/vendor/weiui.generated.css",
      "generated_tokens": "studio/app/src/styles/vendor/weiui.tokens.generated.css",
      "tokens_remain_separate": true,
      "regeneration_requires_exact_pin": true
    },
    "css_import_order": [
      "studio/app/src/styles/vendor/weiui.tokens.generated.css",
      "studio/app/src/styles/vendor/weiui.generated.css",
      "assets/brand/story-loom.weiui.css"
    ]
  },
  "upstream_contract": {
    "cascade_order": [
      "wui-reset",
      "wui-tokens",
      "wui-theme",
      "wui-base",
      "wui-elements",
      "wui-utilities"
    ],
    "minimum_touch_target_px": 44,
    "logical_properties": true,
    "reduced_motion": true,
    "config_unknown_selection_fails_closed": true,
    "config_dependency_closure": true,
    "config_deterministic_fingerprint": true,
    "fragment_subpaths_are_real_outputs": true
  }
