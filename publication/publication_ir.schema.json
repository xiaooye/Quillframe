{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quillframe-publication-ir-v1",
  "type": "object",
  "required": ["schema", "book", "chapters", "source_fingerprint", "text_preservation", "authority"],
  "properties": {
    "schema": {"const": "quillframe_publication_ir_v1"},
    "book": {
      "type": "object",
      "required": ["identifier", "title", "language", "modified"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "modified": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chapter_id", "title", "text", "accepted_fingerprint"],
        "properties": {
          "chapter_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "text": {"type": "string"},
          "accepted_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "source_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "text_preservation": {"const": "exact-unicode-text"},
    "authority": {"const": false}
  },
  "additionalProperties": false
}
