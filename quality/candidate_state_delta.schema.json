{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novelforge_candidate_state_delta_v1",
  "title": "NovelForge Candidate State Delta",
  "type": "object",
  "required": ["schema", "artifact_ref", "base_state_fingerprint", "candidate_fingerprint", "changes", "source_event_ids", "delta_fingerprint", "change_count", "authority", "canon_write", "settlement_authority", "model_execution"],
  "properties": {
    "schema": {"const": "novelforge_candidate_state_delta_v1"},
    "artifact_ref": {"type": "string", "minLength": 1},
    "base_state_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain", "subject_id", "field", "evidence_refs", "event_ids"],
        "properties": {
          "domain": {"enum": ["state", "knowledge", "relationship", "resource", "obligation", "location"]},
          "subject_id": {"type": "string", "minLength": 1},
          "field": {"type": "string", "minLength": 1},
          "before": {},
          "after": {},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "event_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "source_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "delta_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "change_count": {"type": "integer", "minimum": 0},
    "authority": {"const": false},
    "canon_write": {"const": false},
    "settlement_authority": {"const": false},
    "model_execution": {"const": false}
  },
  "additionalProperties": false
}
