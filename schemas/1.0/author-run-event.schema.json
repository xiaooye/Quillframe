{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quillframe.dev/schemas/1.0/author-run-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "run_id", "chapter_id", "cursor", "event_type", "stage", "payload", "created_at", "authority"],
  "properties": {
    "schema": {"const": "quillframe_author_run_event_v1"},
    "project_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "chapter_id": {"const": "CH001"},
    "cursor": {"type": "integer", "minimum": 0},
    "event_type": {"enum": ["run_started", "stage_entered", "stage_completed", "paused", "resumed", "cancelled", "failed", "human_action_required", "completed"]},
    "stage": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "authority": {"const": false}
  }
}
