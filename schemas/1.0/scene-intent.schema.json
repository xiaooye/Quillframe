{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quillframe.dev/schemas/1.0/scene-intent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "chapter_id", "scene_id", "purpose", "desired_change", "constraints"],
  "properties": {
    "schema": {"const": "quillframe_scene_intent_v1"},
    "project_id": {"type": "string", "minLength": 1},
    "chapter_id": {"const": "CH001"},
    "scene_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "desired_change": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
