{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quillframe.dev/schemas/1.0/secret-lease-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lease_id", "service_id", "created_at", "idle_expires_at", "absolute_expires_at", "ciphertext_stored", "secret_value_in_receipt", "authority"],
  "properties": {
    "schema": {"const": "quillframe_secret_lease_receipt_v1"},
    "lease_id": {"type": "string", "minLength": 1},
    "service_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "idle_expires_at": {"type": "string", "format": "date-time"},
    "absolute_expires_at": {"type": "string", "format": "date-time"},
    "ciphertext_stored": {"const": true},
    "secret_value_in_receipt": {"const": false},
    "authority": {"const": false}
  }
}
