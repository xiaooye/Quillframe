{
  "schema": "quillframe_studio_portable_product_contract_v11",
  "authority": false,
  "canon_authority": false,
  "framework_write_authority": false,
  "settlement_authority": false,
  "product_model": "one_product_one_core_many_transports",
  "invariant": "delivery_surface_is_not_source_of_truth",
  "shared_boundary": {
    "direct_core_store_access": false,
    "delivery_surface_may_change_story_semantics": false,
    "host_capability_implies_story_authority": false,
    "request_result_fingerprints": true,
    "secret_values_persisted": false,
    "chapter_scope": "CH001"
  },
  "host_bridge": {
    "contract": "studio/host_bridge_contract.json",
    "implementation": "studio/host_bridge.py",
    "contract_schema": "quillframe_host_bridge_contract_v11",
    "description_schema": "quillframe_host_bridge_description_v11",
    "request_schema": "quillframe_host_bridge_request_v11",
    "result_schema": "quillframe_host_bridge_result_v11",
    "version": "11",
    "authority": false,
    "operation_metadata": ["kind", "required_args", "allowed_surfaces"],
    "agent_package_query_only": true,
    "database_doctor_side_effect_free": true,
    "unsupported_operation_fails_closed": true
  },
  "delivery_surfaces": {
    "cli": {
      "role": "scriptable native inspection and automation surface",
      "direct_core_store_access": false
    },
    "local_app": {
      "role": "creator workstation",
      "direct_browser_store_access": false
    },
    "hosted_web": {
      "role": "hosted product UI",
      "hosting_changes_story_authority": false
    },
    "agent_package": {
      "role": "read-only adapter for external agent frameworks",
      "transport": "versioned capability/query package",
      "private_runtime_imports_required": false,
      "private_persistence_knowledge_required": false,
      "runtime_mutation_allowed": false,
      "allowed_operation_kind": "query",
      "surface_identity": "agent_package"
    }
  },
  "agent_package": {
    "skill": "agent-skills/quillframe/SKILL.md",
    "client": "agent-skills/quillframe/scripts/quillframe_bridge.py",
    "description_source": "live bridge.describe",
    "preflight_before_forward": true,
    "no_compatibility_fallback": true,
    "no_direct_persistence": true,
    "no_model_execution": true,
    "no_project_write": true,
    "no_canon_write": true,
    "no_settlement": true,
    "no_framework_write": true,
    "required_result_invariants": [
      "schema=quillframe_host_bridge_result_v11",
      "bridge_version=11",
      "authority=false"
    ]
  },
  "safe_queries": [
    "bridge.describe",
    "database.doctor",
    "project.list",
    "project.inspect",
    "project.search",
    "document.list",
    "document.open",
    "document.revisions.list",
    "document.revision.compare",
    "author.run.status",
    "author.run.events",
    "model.service.list",
    "model.service.get",
    "model.capabilities",
    "candidate.review.get",
    "candidate.visible.get",
    "settlement.preflight",
    "publication.preview"
  ]
}
