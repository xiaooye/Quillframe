{
  "schema": "quillframe_studio_portable_product_contract_v1",
  "authority": false,
  "canon_authority": false,
  "framework_write_authority": false,
  "settlement_authority": false,
  "invariant": "delivery_surface_is_not_source_of_truth",
  "product_model": "one_product_many_hosts",
  "core_contracts": [
    "quillframe_project_adapter_resolution_v1",
    "quillframe_run_receipt_v1",
    "quillframe_runtime_query_v1",
    "quillframe_runtime_sessions_projection_v1",
    "quillframe_runtime_session_projection_v1",
    "quillframe_runtime_events_projection_v1",
    "quillframe_runtime_handoff_projection_v1",
    "quillframe_run_receipts_projection_v1",
    "quillframe_session_resume_preflight_v1",
    "quillframe_session_resume_command_v1",
    "quillframe_runtime_command_authorization_v1",
    "quillframe_session_terminate_preflight_v1",
    "quillframe_session_terminate_command_v1",
    "quillframe_session_terminate_authorization_v1",
    "quillframe_runtime_command_receipt_v1",
    "quillframe_runtime_command_execution_result_v1",
    "quillframe_runtime_command_receipt_projection_v1",
    "quillframe_context_inspector_v3",
    "quillframe_host_capabilities_v1",
    "quillframe_publication_ir_v1",
    "quillframe_publication_preview_projection_v1"
  ],
  "shared_boundary": {
    "shape": "Core contracts -> stable query/command/projection boundary -> delivery surface",
    "direct_core_store_access": false,
    "delivery_surface_may_change_story_semantics": false,
    "host_capability_implies_story_authority": false,
    "mutation_capability_implies_project_or_canon_authority": false
  },
  "delivery_surfaces": {
    "cli": {
      "role": "scriptable native automation surface",
      "transport": "typed CLI/query/command contracts",
      "may_import_private_runtime_internals": false
    },
    "local_app": {
      "role": "creator workstation",
      "transport": "loopback token-bound local adapter boundary",
      "may_use_local_host_capabilities": true,
      "direct_browser_store_access": false,
      "session_resume_allowed": true,
      "session_resume_requires_explicit_user_action": true,
      "session_terminate_allowed": true,
      "session_terminate_requires_explicit_user_action": true
    },
    "cloud_ui": {
      "role": "hosted product UI",
      "transport": "remote query/command boundary",
      "hosting_changes_story_authority": false,
      "session_resume_allowed": false,
      "session_terminate_allowed": false
    },
    "agent_package": {
      "role": "read-only adapter for external agent frameworks",
      "transport": "versioned capability/query package",
      "host_must_understand_private_persistence": false,
      "host_must_understand_private_python_implementation": false,
      "runtime_mutation_allowed": false
    }
  },
  "phase_2b_host_bridge": {
    "exposed": true,
    "contract": "studio/host_bridge_contract.json",
    "implementation": "studio/host_bridge.py",
    "request_schema": "quillframe_studio_host_bridge_request_v1",
    "result_schema": "quillframe_studio_host_bridge_result_v1",
    "supported_operations": [
      "bridge.describe",
      "framework.doctor",
      "project.inspect",
      "capabilities.inspect",
      "context.inspect",
      "semantic.catalog",
      "publication.preview",
      "runtime.sessions.list",
      "runtime.session.get",
      "runtime.events.list",
      "runtime.handoff.inspect",
      "run.receipt.get",
      "runtime.command.receipt.get",
      "session.resume.preflight",
      "session.resume",
      "session.terminate.preflight",
      "session.terminate"
    ],
    "deferred_operations": [
      "command.invoke",
      "project.mutate",
      "publication.build"
    ],
    "core_dependency": "#23",
    "mutation_exposed": true,
    "mutation_scopes": ["runtime_session_state", "runtime_active_run_state"],
    "mutation_surface": "local_app_only",
    "mutation_requires_operation_specific_contract": true,
    "mutation_requires_explicit_authorization": true,
    "mutation_requires_fresh_preflight": true,
    "mutation_requires_compare_and_swap": true,
    "mutation_requires_idempotent_receipt": true,
    "mutation_runs_model": false,
    "mutation_writes_project": false,
    "mutation_writes_canon": false,
    "mutation_writes_framework": false,
    "mutation_performs_settlement": false,
    "direct_core_store_access": false,
    "request_result_fingerprints": true,
    "unsupported_operation_fails_closed": true
  },
  "runtime_observability": {
    "core_query_tool": "harness/control_plane/runtime_query.py",
    "resume_preflight_tool": "harness/session_runtime/resume_preflight.py",
    "resume_command_tool": "harness/session_runtime/resume_command.py",
    "command_authorization_tool": "harness/session_runtime/runtime_command_authorization.py",
    "command_executor_tool": "harness/session_runtime/runtime_command_executor.py",
    "terminate_preflight_tool": "harness/session_runtime/terminate_preflight.py",
    "terminate_command_tool": "harness/session_runtime/terminate_command.py",
    "terminate_authorization_tool": "harness/session_runtime/terminate_authorization.py",
    "terminate_executor_tool": "harness/session_runtime/terminate_executor.py",
    "query_side_effect_free": true,
    "sqlite_consumer_contract": false,
    "provider_session_identifiers_exposed": false,
    "absolute_host_paths_exposed": false,
    "resume_preflight_exposed": true,
    "session_resume_exposed": true,
    "session_resume_surface": "local_app_only",
    "session_resume_requires_explicit_user_authorization": true,
    "session_resume_requires_fresh_preflight": true,
    "session_resume_requires_exact_before_state_cas": true,
    "session_resume_requires_idempotent_durable_receipt": true,
    "session_resume_model_execution": false,
    "session_resume_project_write": false,
    "session_resume_canon_write": false,
    "session_resume_framework_write": false,
    "session_resume_settlement": false,
    "terminate_preflight_exposed": true,
    "session_terminate_exposed": true,
    "session_terminate_surface": "local_app_only",
    "session_terminate_requires_explicit_user_authorization": true,
    "session_terminate_requires_fresh_preflight": true,
    "session_terminate_requires_exact_before_state_cas": true,
    "session_terminate_requires_idempotent_durable_receipt": true,
    "session_terminate_closes_active_run": true,
    "session_terminate_model_execution": false,
    "session_terminate_project_write": false,
    "session_terminate_canon_write": false,
    "session_terminate_framework_write": false,
    "session_terminate_settlement": false,
    "checkpoint_replay_exposed": false,
    "handoff_mutation_exposed": false,
    "run_receipts_are_metadata_only": true,
    "preflight_ready_grants_runtime_control": false,
    "preflight_ready_plus_authorization_grants_only_declared_command_scope": true
  },
  "publication_preview": {
    "compiler": "publication/compiler.py",
    "projection_schema": "quillframe_publication_preview_projection_v1",
    "profiles": ["text", "web", "print", "epub"],
    "accepted_fingerprint_guard": true,
    "source_authority_invented": false,
    "temporary_build_only": true,
    "project_mutation": false,
    "canon_mutation": false,
    "settlement_mutation": false,
    "model_execution": false,
    "epub_external_release_validation": false
  },
  "agent_package_direction": {
    "phase_2b_read_bridge_exposed": true,
    "agent_skill_path": "agent-skills/quillframe/SKILL.md",
    "client_script": "agent-skills/quillframe/scripts/quillframe_bridge.py",
    "format": "Agent Skills open standard",
    "private_runtime_imports_required": false,
    "private_persistence_knowledge_required": false,
    "runtime_mutation_allowed": false,
    "session_resume_is_local_app_only": true,
    "session_terminate_is_local_app_only": true,
    "future_write_requirement": "each additional mutation needs its own typed Core command plus explicit preconditions, authority policy, CAS/idempotency and durable receipts"
  },
  "project_hub_projection": {
    "source_schema": "quillframe_project_adapter_resolution_v1",
    "output_schema": "quillframe_studio_project_hub_projection_v1",
    "reject_unknown_source_schema": true,
    "exact_source_fingerprint_required": true,
    "projection_fingerprint_required": true,
    "project_root_exposed": false,
    "absolute_paths_exposed": false,
    "infer_story_state_from_path_existence": false
  },
  "scene_workspace": {
    "modes": ["focus", "analysis", "compare", "review"],
    "separate_axes": [
      "manuscript_authority",
      "runtime_execution_state",
      "semantic_findings",
      "provenance",
      "host_capability"
    ]
  },
  "deliberately_undecided": [
    "frontend_framework",
    "desktop_wrapper",
    "cloud_provider",
    "auth_provider",
    "database_topology",
    "external_agent_framework",
    "billing_or_subscription_system"
  ]
}
