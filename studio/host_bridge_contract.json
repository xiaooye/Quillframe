    "manuscript_visibility_requires_production_release": true,
    "host_self_generated_manuscript_is_releaseable": false,
    "ephemeral_runtime_exact_git_identity_required": true,
    "production_checkpoint_manuscript_private_from_agent_package": true,
    "project_scope_is_novel": true,
    "project_learning_is_project_scoped": true,
    "model_reader_feedback_is_advisory_only": true,
    "settled_state_requires_preflight_confirmation": true,
    "context_refresh_requires_fresh_run": true,
    "production_checkpoint_manuscript_private_from_all_surfaces": true,
    "hosted_web_local_corpus_paths": false,
    "corpus_selection_limit_maximum": 24,
    "corpus_selection_profiles": [
      "general",
      "adult_explicit"
