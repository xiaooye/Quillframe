    "corpus_private_labels_local_only": true,
    "corpus_selection_propose_requires_one_of_collection_or_study": true,
    "corpus_eligibility_details_private_aggregate_counts_only": true,
    "corpus_public_release_grants_authority": false,
    "corpus_style_publication_requires_explicit_protocol": true,
    "corpus_style_preview_never_implies_release": true,
    "corpus_style_release_requires_trusted_receipts": true,
    "corpus_style_registry_path_host_owned": true,
    "user_taste_auto_activation_is_explicit_policy": true
