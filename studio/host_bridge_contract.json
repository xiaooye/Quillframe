{
  "schema": "novelforge_studio_host_bridge_contract_v1",
  "version": "1",
  "authority": false,
  "canon_authority": false,
  "framework_write_authority": false,
  "settlement_authority": false,
  "model_execution": false,
  "product_model": "one_product_many_hosts",
  "request_schema": "novelforge_studio_host_bridge_request_v1",
  "result_schema": "novelforge_studio_host_bridge_result_v1",
  "surfaces": [
    "cli",
    "local_app",
    "cloud_ui",
    "agent_package"
  ],
  "invariants": {
    "delivery_surface_is_not_source_of_truth": true,
    "direct_core_store_access": false,
    "absolute_host_paths_in_results": false,
    "capability_implies_authority": false,
    "unsupported_operation_fails_closed": true,
    "mutation_exposed": false
  },
  "operations": {
    "supported": {
      "bridge.describe": {
        "kind": "query",
        "core_basis": "Studio machine contract",
        "required_args": []
      },
      "framework.doctor": {
        "kind": "query",
        "core_basis": "novelforge.py doctor",
        "required_args": []
      },
      "project.inspect": {
        "kind": "query",
        "core_basis": "Project Adapter + novelforge_studio_project_hub_projection_v1",
        "required_args": ["project_root"]
      },
      "capabilities.inspect": {
        "kind": "query",
        "core_basis": "novelforge_host_capabilities_v1",
        "required_args": []
      },
      "context.inspect": {
        "kind": "query",
        "core_basis": "novelforge_context_inspector_v2",
        "required_args": ["project_root", "manifest"]
      },
      "semantic.catalog": {
        "kind": "query",
        "core_basis": "semantic model contract catalog CLI",
        "required_args": []
      },
      "runtime.sessions.list": {
        "kind": "query",
        "core_basis": "novelforge_runtime_sessions_projection_v1 via novelforge.py runtime-query",
        "required_args": ["project_root"]
      },
      "runtime.session.get": {
        "kind": "query",
        "core_basis": "novelforge_runtime_session_projection_v1 via novelforge.py runtime-query",
        "required_args": ["project_root", "session_id"]
      },
      "runtime.events.list": {
        "kind": "query",
        "core_basis": "novelforge_runtime_events_projection_v1 via novelforge.py runtime-query",
        "required_args": ["project_root"]
      },
      "runtime.handoff.inspect": {
        "kind": "query",
        "core_basis": "novelforge_runtime_handoff_projection_v1 via novelforge.py runtime-query",
        "required_args": ["project_root", "handoff_id"]
      },
      "run.receipt.get": {
        "kind": "query",
        "core_basis": "novelforge_run_receipts_projection_v1 via novelforge.py runtime-query",
        "required_args": ["project_root"]
      }
    },
    "deferred": {
      "session.resume": {
        "kind": "command",
        "reason": "no stable public host command envelope with checkpoint revalidation, before-state preconditions, CAS/idempotency, capability evidence, and authority checks",
        "dependency": "#23"
      },
      "command.invoke": {
        "kind": "command",
        "reason": "write-capable host operations require typed Core command, authority, preconditions, CAS/idempotency, and receipts",
        "dependency": "#23"
      },
      "project.mutate": {
        "kind": "command",
        "reason": "Project mutation remains behind explicit Core authority/settlement operations",
        "dependency": "#23"
      }
    }
  },
  "agent_skill": {
    "format": "Agent Skills open standard",
    "path": "agent-skills/novelforge/SKILL.md",
    "client_script": "agent-skills/novelforge/scripts/novelforge_bridge.py",
    "private_python_imports_required": false,
    "private_persistence_layout_required": false
  },
  "core_dependencies": ["#23"]
}
