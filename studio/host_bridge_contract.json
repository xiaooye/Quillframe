    "access_token_in_request_fingerprint": false,
    "access_token_in_context": false,
    "access_token_in_agent_job": false,
    "access_token_in_receipt": false,
    "access_token_in_export": false,
    "desktop_expected_host_store": "tauri_os_keychain_secret_store",
    "hosted_expected_host_store": "server_side_secure_secret_or_session_store",
    "process_fallback": "memory_secret_store_non_durable",
    "cloudflare_required": false
