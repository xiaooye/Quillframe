{
  "schema": "quillframe_studio_host_bridge_contract_v1",
  "version": "5",
  "framework_version": "0.9.0",
  "authority": false,
  "canon_authority": false,
  "framework_write_authority": false,
  "settlement_authority": false,
  "direct_core_store_access": false,
  "product_model": "one_product_one_core_many_transports",
  "surfaces": ["cli", "local_app", "hosted_web", "tauri_local", "agent_package"],
  "invariants": {
    "browser_sqlite_access": false,
    "generic_mutation_dispatch": false,
    "exact_primary_task_mode": true,
    "audit_rewrite": false,
    "draft_settlement": false,
    "acceptance_is_settlement": false,
    "feedback_auto_promote": false,
    "corpus_is_canon": false,
    "research_is_character_knowledge": false,
    "secret_in_semantic_context": false,
    "credential_value_persisted": false,
    "browser_project_authority": false,
    "host_provider_in_core_contract": false
  },
  "operations": {
    "bridge.describe": {"kind":"query","required_args":[]},
    "database.doctor": {"kind":"query","required_args":[]},

    "project.list": {"kind":"query","required_args":[]},
    "project.create": {"kind":"command","required_args":["project_id","title"]},
    "project.inspect": {"kind":"query","required_args":["project_id"]},
    "project.search": {"kind":"query","required_args":["project_id","query"]},
    "project.backup": {"kind":"command","required_args":["project_id"]},
    "project.export": {"kind":"command","required_args":["project_id"]},
    "project.import": {"kind":"command","required_args":["artifact_ref"]},
    "project.delete": {"kind":"authority_command","required_args":["project_id","confirm_project_id","user_authorized"],"allowed_surfaces":["cli","local_app","hosted_web","tauri_local"]},
    "artifact.read": {"kind":"query","required_args":["artifact_ref"]},
    "artifact.upload": {"kind":"command","required_args":["file_name","payload_base64"]},

    "document.list": {"kind":"query","required_args":["project_id"]},
    "document.get": {"kind":"query","required_args":["project_id","document_id"]},
    "document.create": {"kind":"command","required_args":["project_id","document_id","title"]},
    "document.revisions.list": {"kind":"query","required_args":["project_id","document_id"]},
    "document.revision.save": {"kind":"command","required_args":["project_id","document_id","content","source"]},
    "document.revision.compare": {"kind":"query","required_args":["project_id","left_revision_id","right_revision_id"]},
    "document.revision.restore": {"kind":"command","required_args":["project_id","document_id","revision_id"]},

    "story.inspect": {"kind":"query","required_args":["project_id"]},
    "plan.inspect": {"kind":"query","required_args":["project_id"]},

    "model.connect": {"kind":"command","required_args":["endpoint","access_token"],"allowed_surfaces":["local_app","hosted_web","tauri_local"]},
    "model.list": {"kind":"query","required_args":[]},
    "model.get": {"kind":"query","required_args":["service_id"]},

    "author.run.start": {"kind":"command","required_args":["project_id","task_mode","payload"]},
    "candidate.list": {"kind":"query","required_args":["project_id"]},
    "candidate.get": {"kind":"query","required_args":["project_id","candidate_id"]},
    "candidate.accept": {"kind":"authority_command","required_args":["project_id","candidate_id","candidate_fingerprint","authorized_by","authorization","idempotency_key","user_authorized"],"allowed_surfaces":["cli","local_app","hosted_web","tauri_local"]},
    "settlement.apply": {"kind":"authority_command","required_args":["project_id","acceptance_id","target_ref","expected_before_fingerprint","idempotency_key","user_authorized"],"allowed_surfaces":["cli","local_app","hosted_web","tauri_local"]},
    "feedback.observe": {"kind":"command","required_args":["project_id","evidence_kind","payload"]},

    "publication.preview": {"kind":"query","required_args":["project_id","acceptance_id"]},
    "publication.build": {"kind":"command","required_args":["project_id","acceptance_id"]},

    "inspector.sessions.list": {"kind":"query","required_args":["project_id"]},
    "inspector.runs.list": {"kind":"query","required_args":["project_id"]},
    "inspector.checkpoints.list": {"kind":"query","required_args":["project_id"]},
    "inspector.context.list": {"kind":"query","required_args":["project_id"]},
    "inspector.receipts.list": {"kind":"query","required_args":["project_id"]},
    "inspector.candidates.list": {"kind":"query","required_args":["project_id"]},
    "inspector.learning.list": {"kind":"query","required_args":["project_id"]},
    "inspector.reviews.list": {"kind":"query","required_args":["project_id"]},
    "inspector.settlements.list": {"kind":"query","required_args":["project_id"]}
  },
  "deferred_operations": {
    "author.run.execute": "Production semantic graph must dispatch and independently qualify the exact run before a candidate can be exposed.",
    "story.mutate": "No generic Story authority mutation contract exists.",
    "plan.mutate": "No generic Plan authority mutation contract exists.",
    "desktop.credential.remember": "Requires a proven OS credential backend; plaintext/SQLite fallback is forbidden."
  },
  "forbidden_operations": ["command.invoke", "project.mutate", "audit.rewrite", "draft.settle", "feedback.promote"]
}
