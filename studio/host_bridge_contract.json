  "deferred_operations": {
    "project.delete": {
      "status": "unsupported",
      "reason": "no Core-owned reversible delete transaction yet"
    },
    "project.export": {
      "status": "awaiting_external",
      "reason": "portable project export/import transport is not part of this Core change"
    },
    "project.import": {
      "status": "awaiting_external",
      "reason": "portable project export/import transport is not part of this Core change"
    },
    "candidate.review.request": {
      "status": "unsupported",
      "reason": "production run owns mandatory review; no free-floating review authority is fabricated"
    }
